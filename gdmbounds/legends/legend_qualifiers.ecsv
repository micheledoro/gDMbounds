# ---
# datatype:
# - {name: shortname  , unit:  , datatype: string , description: qualifier as it appears in a filename }
# - {name: class      , unit:  , datatype: string , description: what the qualifier varies              }
# - {name: comment    , unit:  , datatype: string , description: comment/explanation                    }
# meta: !!omap
# - {comment:        'Legend for the qualifiers a filename may carry after the channel'}
# schema : astropy -2.0

shortname          class       comment
nfw                profile     "Navarro-Frenk-White"
einasto            profile     "Einasto"
burkert            profile     "Burkert"
iso                profile     "isothermal"
cored              profile     "a cored halo, the paper naming the parameters"
cusped             profile     "a cusped halo, the paper naming the parameters"
core               profile     "a cored halo; CTAO spelling of the same idea as cored"
cusp               profile     "a cusped halo; CTAO spelling of the same idea as cusped"
zhaocored          profile     "cored Zhao"
acnfw              profile     "adiabatically contracted NFW"
nfwrb02            profile     "NFW variant of the H.E.S.S. Fornax analysis; the suffix names the parameter set, to confirm against the paper"
nfwdw01            profile     "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
nfwrs08            profile     "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
nfwsr10a6          profile     "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
burkertsr10a6      profile     "Burkert variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
nfwburkertsr10a10  profile     "a halo built from NFW and Burkert together; the vocabulary has no single term for it, so the header profile is left empty"
r16einasto         profile     "Einasto over a 16 degree region of interest"
r40nfw             profile     "NFW over a 40 degree region of interest"
r150nfw            profile     "NFW over a 150 degree region of interest"
r86isothermal      profile     "isothermal over an 86 degree region of interest"
NFWmax             profile     "NFW with the highest J-factor of the range considered"
NFWmean            profile     "NFW with the mean J-factor of the range considered"
ISOmax             profile     "isothermal with the highest J-factor of the range considered"
ISOmean            profile     "isothermal with the mean J-factor of the range considered"
sens               statement   "a projection rather than a measurement; must agree with statement in the header"
median             band        "the median of the null-hypothesis realisations, the expected limit"
med                band        "the middle of a range of assumptions; HAWC spelling"
min                band        "the weakest of a range of assumptions"
max                band        "the strongest of a range of assumptions"
lo                 band        "the lower edge of a range of assumptions"
up                 band        "the upper edge of a range of assumptions"
noseg1             sample      "the stack with Segue 1 removed"
notri2             sample      "the stack with Triangulum II removed"
nosagittarius      sample      "the stack with Sagittarius removed"
oneD               analysis    "one-dimensional treatment of the likelihood"
frequentist        analysis    "frequentist rather than Bayesian"
unbinned           analysis    "unbinned likelihood"
statreach          analysis    "statistical reach only, systematics excluded"
sigmaveff          analysis    "an effective cross-section rather than the bare one"
ib                 analysis    "internal bremsstrahlung included in the spectrum"
sommerfeld         analysis    "Sommerfeld enhancement included"
nobck              analysis    "computed with no background component"
noJerror           analysis    "the J-factor uncertainty is not propagated, which makes the limit stronger than it would otherwise be"
benchmark          analysis    "a specific benchmark model rather than a single annihilation channel"
measured           analysis    "the observed curve where the same paper also publishes a benchmark one"
lstonly            setup       "the CTAO large-sized telescopes alone"
mstonly            setup       "the CTAO medium-sized telescopes alone"
expo               setup       "an exposure variant of the CTAO survey; to confirm against the paper"
theta01deg         setup       "an integration radius of 0.1 degrees"
theta1deg          setup       "an integration radius of 1 degree"
substructure-high  setup       "the higher of the substructure boosts considered"
substructure-med   setup       "the middle substructure boost considered"
FermiLAT           setup       "the MWA radio limit under the electron background taken from Fermi-LAT; to confirm against the paper"
cosmicrays         setup       "the MWA radio limit under a cosmic-ray electron background; to confirm against the paper"
funk               provenance  "the J-factor or model set of Funk et al."
ando               provenance  "the model set of Ando et al."
blazquezdoro       provenance  "the model set of Blazquez and Doro"
bonnivard          provenance  "the J-factors of Bonnivard et al."
geringersameth     provenance  "the J-factors of Geringer-Sameth et al."
initial            provenance  "the first of two analyses of the same data in one paper"
final              provenance  "the second of two analyses of the same data in one paper"
v1                 provenance  "a first version where the paper offers more than one; to confirm against the paper"
