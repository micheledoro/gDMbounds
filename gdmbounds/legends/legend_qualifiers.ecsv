# ---
# datatype:
# - {name: shortname  , unit:  , datatype: string , description: qualifier as it appears in a filename    }
# - {name: profile    , unit:  , datatype: string , description: halo profile it names, -- if it names none }
# - {name: comment    , unit:  , datatype: string , description: comment/explanation                      }
# meta: !!omap
# - {comment:        'Legend for the qualifiers a filename may carry after the channel. A qualifier distinguishes one curve of a paper from another; what is merely true of a curve belongs in its header. Only the profile is mapped here, because that mapping is the one a test can use.'}
# schema : astropy -2.0

shortname          profile     comment
nfw                nfw         "Navarro-Frenk-White"
acnfw              nfw         "adiabatically contracted NFW"
nfwrb02            nfw         "NFW variant of the H.E.S.S. Fornax analysis; the suffix names the parameter set, to confirm against the paper"
nfwdw01            nfw         "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
nfwrs08            nfw         "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
nfwsr10a6          nfw         "NFW variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
r40nfw             nfw         "NFW over a 40 degree region of interest"
r150nfw            nfw         "NFW over a 150 degree region of interest"
NFWmax             nfw         "NFW with the highest J-factor of the range considered"
NFWmean            nfw         "NFW with the mean J-factor of the range considered"
einasto            einasto     "Einasto"
r16einasto         einasto     "Einasto over a 16 degree region of interest"
burkert            burkert     "Burkert"
burkertsr10a6      burkert     "Burkert variant of the H.E.S.S. Fornax analysis; suffix to confirm against the paper"
iso                isothermal  "isothermal"
r86isothermal      isothermal  "isothermal over an 86 degree region of interest"
ISOmax             isothermal  "isothermal with the highest J-factor of the range considered"
ISOmean            isothermal  "isothermal with the mean J-factor of the range considered"
cored              cored       "a cored halo, the paper naming the parameters"
core               cored       "a cored halo; CTAO spelling of cored"
zhaocored          cored       "cored Zhao"
cusped             cusped      "a cusped halo, the paper naming the parameters"
cusp               cusped      "a cusped halo; CTAO spelling of cusped"
nfwburkertsr10a10  --          "a halo built from NFW and Burkert together; no single profile, so the header is left empty"
sens               --          "a projection rather than a measurement; must agree with statement in the header"
median             --          "the median of the null-hypothesis realisations, the expected limit. Not the middle of a range: that is med"
med                --          "the middle of a range of assumptions"
min                --          "the weakest of a range of assumptions"
max                --          "the strongest of a range of assumptions"
lo                 --          "the lower edge of a range of assumptions; H.E.S.S. spelling of min"
up                 --          "the upper edge of a range of assumptions; H.E.S.S. spelling of max"
noseg1             --          "the stack with Segue 1 removed"
notri2             --          "the stack with Triangulum II removed"
nosagittarius      --          "the stack with Sagittarius removed"
oneD               --          "one-dimensional treatment of the likelihood"
frequentist        --          "frequentist rather than Bayesian"
unbinned           --          "unbinned likelihood"
statreach          --          "statistical reach only, systematics excluded"
sigmaveff          --          "an effective cross-section rather than the bare one"
ib                 --          "internal bremsstrahlung included in the spectrum"
sommerfeld         --          "Sommerfeld enhancement included"
nobck              --          "computed with no background component"
noJerror           --          "the J-factor uncertainty is not propagated, which makes the limit stronger than it would otherwise be"
benchmark          --          "a specific benchmark model rather than a single annihilation channel"
measured           --          "the observed curve where the same paper also publishes a benchmark one"
lstonly            --          "the CTAO large-sized telescopes alone"
mstonly            --          "the CTAO medium-sized telescopes alone"
expo               --          "an exposure variant of the CTAO survey; to confirm against the paper"
theta01deg         --          "an integration radius of 0.1 degrees"
theta1deg          --          "an integration radius of 1 degree"
substructure-high  --          "the higher of the substructure boosts considered"
substructure-med   --          "the middle substructure boost considered"
FermiLAT           --          "the MWA radio limit under the electron background taken from Fermi-LAT; to confirm against the paper"
cosmicrays         --          "the MWA radio limit under a cosmic-ray electron background; to confirm against the paper"
funk               --          "the J-factor or model set of Funk et al."
ando               --          "the model set of Ando et al."
blazquezdoro       --          "the model set of Blazquez and Doro"
bonnivard          --          "the J-factors of Bonnivard et al."
geringersameth     --          "the J-factors of Geringer-Sameth et al."
initial            --          "the first of two analyses of the same data in one paper"
final              --          "the second of two analyses of the same data in one paper"
v1                 --          "a first version where the paper offers more than one; to confirm against the paper"
