# Do not commit the followings:

**/.DS_Store
**/.ipynb_checkpoints/
sandbox/aleksandra/outputs/*.png
sandbox/aleksandra/outputs/*/*.png

# Build artefacts
*.egg-info/
build/
dist/
__pycache__/
.pytest_cache/

# Third-party code someone cloned into a sandbox rather than depending on it.
# HDMSpectra is a public MIT package (github.com/nickrodd/HDMSpectra); it was
# committed here as a gitlink with no .gitmodules entry, which broke
# `git submodule status` and gave every clone an empty directory.
sandbox/kumar/HDMSpectra/

# Example figures are generated, never committed: see tools/example_figures.py
figures/

# The papers the bounds were transcribed from. Other people's publications:
# fetched locally so the source can sit open beside the data during a review,
# never redistributed from here. `python tools/fetch_papers.py` refills the
# directory on a new clone.
papers/*
!papers/README.md
